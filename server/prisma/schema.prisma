datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  displayName  String
  passwordHash String
  role         String        @default("receptionist")
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     UserSession[]
}

model UserSession {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
}

model ClinicSettings {
  id                  Int              @id @default(1)
  clinicName          String           @default("DentalPro")
  timezone            String           @default("Europe/Lisbon")
  slotIntervalMinutes Int              @default(30)
  schedules           ClinicSchedule[]
  closures            ClinicClosure[]
  appointmentTypes    AppointmentType[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model ClinicSchedule {
  id         Int           @id @default(autoincrement())
  settingsId Int
  weekday    Int
  isOpen     Boolean       @default(false)
  startTime  String        @default("08:00")
  endTime    String        @default("20:00")
  breakStart String?
  breakEnd   String?
  settings   ClinicSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, weekday])
}

model ClinicClosure {
  id         Int           @id @default(autoincrement())
  settingsId Int
  date       DateTime
  label      String
  settings   ClinicSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, date])
  @@index([date])
}

model AppointmentType {
  id         Int           @id @default(autoincrement())
  settingsId Int
  name       String
  duration   Int           @default(30)
  isActive   Boolean       @default(true)
  settings   ClinicSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([settingsId, name])
}

model ProviderSchedule {
  id         Int      @id @default(autoincrement())
  doctorId   Int
  weekday    Int
  isWorking  Boolean  @default(true)
  startTime  String   @default("08:00")
  endTime    String   @default("20:00")
  breakStart String?
  breakEnd   String?
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, weekday])
}

model Patient {
  id           Int           @id @default(autoincrement())
  fullName     String
  phone        String
  email        String
  nif          String        @unique
  nationality  String
  dateOfBirth  DateTime?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Doctor {
  id           Int           @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  nif          String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  schedules    ProviderSchedule[]
}

model Appointment {
  id                 Int      @id @default(autoincrement())
  patientId          Int
  patient            Patient  @relation(fields: [patientId], references: [id])
  doctorId           Int
  doctor             Doctor   @relation(fields: [doctorId], references: [id])
  date               DateTime
  time               String // Format: "HH:MM" (e.g., "09:00")
  duration           Int      @default(30)
  treatmentType      String // Scheduled treatment
  performedTreatment String? // Completed treatment result
  status             String   @default("scheduled") // scheduled, arrived, completed, cancelled, no_show
  notes              String?
  completionNotes    String?
  createdAt          DateTime @default(now())
}
