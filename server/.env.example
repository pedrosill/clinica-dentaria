NODE_ENV=development
PORT=5000
DATABASE_URL="file:./dev.db"
CLIENT_ORIGIN="http://localhost:5173"
# Keep the API bound to the clinic computer for a local-only deployment.
# The server rejects non-loopback HOST values when LOCAL_ONLY is enabled.
HOST="127.0.0.1"
# Allows a production build to use HTTP on loopback without exposing it to the network.
LOCAL_ONLY=true
TRUST_PROXY=""

# Development startup creates this administrator when the database has no users.
# Override these values in server/.env if needed; never use the development
# defaults for a deployed production instance.
DEFAULT_ADMIN_EMAIL="admin@dentalpro.local"
DEFAULT_ADMIN_NAME="DentalPro Administrator"
DEFAULT_ADMIN_PASSWORD="DentalProAdmin123!"

# Production startup provisioning is disabled. Use `npm run admin:create --prefix server`
# while the server is stopped. Do not set CREATE_DEFAULT_ADMIN in production.
# CREATE_DEFAULT_ADMIN=false

# Local backup defaults. In production, set BACKUP_ENCRYPTION_KEY (or
# BACKUP_ENCRYPTION_KEY_FILE) because encrypted backups are mandatory there.
# BACKUP_DIR="./backups"
# BACKUP_RETENTION_COUNT=7
# BACKUP_ENCRYPTION_KEY=""
# BACKUP_ENCRYPTION_KEY_FILE=""
# BACKUP_SECONDARY_DIR=""
# BACKUP_STATUS_FILE=""
# PRIVATE_DOCUMENTS_DIR=""
# MFA_ENCRYPTION_KEY=""
# PASSWORD_RECOVERY_BASE_URL="https://clinic.example/recover"
